# ─── History Scanner configuration ────────────────────────────────────────────
# Copy this file to ".env" and fill in your values:  cp .env.example .env

# ── LLM enhancement (Claude) ─────────────────────────────────────────────────
# marker's --use_llm mode dramatically improves accuracy on handwritten and
# historical documents. It is enabled by default and uses Anthropic Claude.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model marker should call for OCR clean-up / correction.
CLAUDE_MODEL_NAME=claude-sonnet-4-6

# marker LLM service class. Swap this (and the matching *_API_KEY) to use a
# different provider, e.g. marker.services.gemini.GoogleGeminiService
MARKER_LLM_SERVICE=marker.services.claude.ClaudeService

# ── Default scan options (the UI can override these per-document) ─────────────
# Use Claude LLM enhancement by default (true is best for handwriting).
DEFAULT_USE_LLM=true
# Force OCR on every page instead of trusting embedded text – best for scans.
DEFAULT_FORCE_OCR=true

# ── Server / runtime ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Max upload size in megabytes.
MAX_UPLOAD_MB=50

# How many documents to OCR at once. Keep at 1 unless you have lots of VRAM
# (marker uses ~5GB of GPU memory per concurrent worker).
MAX_CONCURRENT_JOBS=1

# Force a compute device for the models. Leave blank to auto-detect.
# Options: cuda (NVIDIA GPU), mps (Apple Silicon), cpu.
# TORCH_DEVICE=cpu

# Where uploads and OCR results are written.
DATA_DIR=/tmp/history-scanner
